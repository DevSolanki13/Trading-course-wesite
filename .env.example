# ==============================================================================
# GlobalBulls Environment Configuration Template
# Copy this file to .env.local and populate with your own credentials.
# Empty values intentionally mean NOT CONFIGURED.
# Never commit .env.local. Note: NEXT_PUBLIC_ variables are exposed to the client.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROJECT_STAGE=staging

# Supabase Auth & Database API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Direct/Session-Pooler PostgreSQL Connection URL (for migrations and server operations)
# Keep sslmode=require (or stronger verified TLS) on hosted connections.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-pooler.supabase.com:5432/postgres
DATABASE_CA_CERT_PATH=

# Payment Provider Configuration (Cashfree Sandbox)
PAYMENT_MODE=cashfree-sandbox
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
PAYMENT_PROVIDER=

# Public HTTPS origin for Cashfree webhooks and callbacks (cannot be localhost)
INTEGRATION_PUBLIC_URL=

# Video Streaming (VdoCipher)
VDOCIPHER_API_SECRET=
VDOCIPHER_TEST_VIDEO_ID=

# Email Delivery (Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
PROVIDER_TEST_EMAIL=

# Email Delivery Fallback (Gmail SMTP)
# If using Gmail SMTP for auth emails, provide your Gmail address and 16-char App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Authentication & Admin Access
# Dedicated secret key for instant admin terminal login (/admin/login)
ADMIN_SECRET_KEY=globalbulls-admin

# Google OAuth (configured in Supabase Dashboard -> Auth -> Providers -> Google)
GOOGLE_OAUTH_CONFIGURED=true

# Security & Feature Flags
LIVE_CHECKOUT_ENABLED=false
OPERATIONS_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
CRON_SECRET=
