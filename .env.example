# ==============================================================================
# GlobalBulls Environment Configuration Template
# Copy this file to .env.local and populate with your own credentials.
# Empty values intentionally mean NOT CONFIGURED.
# Never commit .env.local. Note: NEXT_PUBLIC_ variables are exposed to the client.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROJECT_STAGE=staging

# Supabase Auth & Database API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Direct/Session-Pooler PostgreSQL Connection URL (for migrations and server operations)
# Keep sslmode=require (or stronger verified TLS) on hosted connections.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-pooler.supabase.com:5432/postgres
DATABASE_CA_CERT_PATH=

# Payment Provider Configuration (IndianXtrade UPI bank relay)
PAYMENT_MODE=upi
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
PAYMENT_PROVIDER=upi
ALLOW_MOCK_PAYMENTS=false
ALLOW_TEST_PAYMENTS=false
# Apply the UPI migrations through 028 and verify the existing IndianXtrade relay first.
UPI_PAYMENTS_ENABLED=off
# Shared account: reuse IndianXtrade’s existing gateway and its central amount allocator.
UPI_GATEWAY=indianxtrade
INDIANXTRADE_COLLECTOR_EMAIL=
INDIANXTRADE_COLLECTOR_PASSWORD=
INDIANXTRADE_SESSION_TOKEN=
# Pilot users can test while public checkout stays off.
UPI_RELAY_ENABLED=off
UPI_PILOT_USER_IDS=
# Same complete approved account list as IndianXtrade; comma-separated. Each order uses the gateway's reserved QR.
UPI_COLLECTION_VPAS=
# Legacy single-account fallback when UPI_COLLECTION_VPAS is empty (also used by the standalone relay).
UPI_COLLECTION_VPA=
UPI_PAYEE_NAME=IndianXtrade Academy
UPI_ACCOUNT_MARKERS=
UPI_RELAY_SENDERS=
SMS_RELAY_SECRET=

# Public HTTPS origin for Cashfree webhooks and callbacks (cannot be localhost)
INTEGRATION_PUBLIC_URL=

# Video Streaming (VdoCipher)
VDOCIPHER_API_SECRET=
VDOCIPHER_TEST_VIDEO_ID=

# Email Delivery (Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
PROVIDER_TEST_EMAIL=

# Email Delivery Fallback (Gmail SMTP)
# If using Gmail SMTP for auth emails, provide your Gmail address and 16-char App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Authentication & Admin Access
# Dedicated secret key for instant admin terminal login (/admin/login)
ADMIN_SECRET_KEY=globalbulls-admin

# Google OAuth (configured in Supabase Dashboard -> Auth -> Providers -> Google)
GOOGLE_OAUTH_CONFIGURED=true

# Security & Feature Flags
LIVE_CHECKOUT_ENABLED=false
OPERATIONS_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
CRON_SECRET=
