# Copy to .env.local. Empty values intentionally mean NOT CONFIGURED.
# Never commit .env.local. NEXT_PUBLIC_ values are visible to visitors.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROJECT_STAGE=staging
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use the staging project's direct/session-pooler PostgreSQL URL for migrations.
# Keep sslmode=require (or stronger verified TLS) on hosted connections.
DATABASE_URL=

# Keep sandbox until a separately approved live integration is completed.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Public HTTPS origin for sandbox callbacks; localhost is not reachable by Cashfree.
INTEGRATION_PUBLIC_URL=

VDOCIPHER_API_SECRET=
VDOCIPHER_TEST_VIDEO_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PROVIDER_TEST_EMAIL=

# Google credentials are configured in Supabase's dashboard, NOT in the browser.
# Set this only after both the Supabase provider and Google redirect URI are set up.
GOOGLE_OAUTH_CONFIGURED=false
# Phase 0 cannot accept live payments, regardless of this future feature flag.
LIVE_CHECKOUT_ENABLED=false
