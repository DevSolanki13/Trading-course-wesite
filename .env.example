# New purchase flow: no variables are needed for local mock development.
# Normal app startup selects Razorpay only when this selector and both keys exist.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Independent secret configured on the Razorpay webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=
# Explicit test-only override. Never enable on a real sales deployment.
ALLOW_MOCK_PAYMENTS=false
# Optional local-store override; dev:demo sets this without changing your .env.
LOCAL_DEMO=
# Only permits demo users in an explicitly opted-in production test store.
SEED_DEMO_USERS=false
# Existing Supabase auth manages production sessions. Local opaque sessions need
# no signing secret; this name is reserved for a future auth-library integration.
AUTH_SECRET=

# Legacy Cashfree/demo routes remain isolated behind their old explicit modes.
PAYMENT_MODE=
NEXT_PUBLIC_PAYMENT_MODE=
PROJECT_STAGE=staging
DEMO_PAYMENT_SECRET=change-me-in-preview-only

# Use the exact application origin. Keep preview and production projects separate.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Download the trusted CA from the Supabase project's Database Settings.
# Keep it outside public/. Never disable certificate verification.
DATABASE_CA_CERT_PATH=
GOOGLE_OAUTH_CONFIGURED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PROVIDER_TEST_EMAIL=
VDOCIPHER_API_SECRET=
VDOCIPHER_TEST_VIDEO_ID=
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
INTEGRATION_PUBLIC_URL=

# Unset/false by default. Only sandbox/staging execution is supported.
# PAYMENT_MODE=cashfree-sandbox enables the sandbox flow after migration 009.
OPERATIONS_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
CRON_SECRET=
