<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.READ_SMS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <service
      android:name="expo.modules.smsreader.RelayForegroundService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Owner-enabled continuous bank SMS and merchant payment notification monitoring for immediate payment confirmation, with a visible listening notification." />
    </service>
    <service android:name="expo.modules.smsreader.RelayRetryService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    <receiver android:name="expo.modules.smsreader.RelayBootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <receiver
      android:name="expo.modules.smsreader.SmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>

    <!--
      PhonePe Business doesn't send a bank SMS when its own merchant QR is
      paid; the money reaches our bank only at daily settlement. Instead the
      Business app posts a system notification per payment. This listener
      reads those via the NotificationListenerService API and forwards them
      to the same bank-feed ingestion endpoint the SMS pipeline uses.
      Requires the user to enable "Notification access" in system settings;
      the permission below is granted by that toggle, not at install time.
    -->
    <service
      android:name="expo.modules.smsreader.NotificationListener"
      android:label="IndianXtrade Payments notification listener"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
