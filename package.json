{
  "name": "trading-course-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:ui": "node backend/scripts/verify-storefront.mjs",
    "test:auth": "node backend/scripts/verify-auth.mjs",
    "test:auth:ui": "node backend/scripts/verify-auth-ui.mjs",
    "test:learning": "node backend/scripts/verify-learning.mjs",
    "admin:bootstrap": "node backend/scripts/bootstrap-admin.mjs",
    "test:admin": "node backend/scripts/verify-admin.mjs",
    "notifications:send": "node backend/scripts/send-notifications.mjs",
    "test:email": "node backend/scripts/verify-email.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "env:check": "node backend/scripts/preflight.mjs",
    "providers:check": "node backend/scripts/providers.mjs",
    "providers:cashfree": "node backend/scripts/providers.mjs cashfree",
    "providers:video": "node backend/scripts/providers.mjs video",
    "providers:email": "node backend/scripts/providers.mjs email",
    "smoke": "node backend/scripts/smoke.mjs",
    "db:migrate": "node backend/scripts/migrate.mjs",
    "db:verify": "node backend/scripts/verify-database.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
